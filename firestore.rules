rules_version = '2';

// Default deny. Firestore holds status, flags and corrections only (ARCHITECTURE.md).
// No client documents, no government credentials, ever (SECURITY.md).
// Each allow rule added later needs a test in tests/integration/firestore.rules.test.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
