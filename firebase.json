{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        ".github",
        "scripts",
        ".claude",
        ".agents",
        "web",
        "dist",
        "tests",
        "evals",
        "docs",
        "AGENTS.md",
        "ARCHITECTURE.md",
        "CLAUDE.md",
        "DESIGN.md",
        "EVALS.md",
        "PRD.md",
        "PROGRESS.md",
        "README.md",
        "TASKS.md",
        "firebase-debug.log",
        "playwright-report",
        "test-results"
      ],
      "predeploy": [
        "npm run build:functions"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "npm run build:web"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
