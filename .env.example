# Names only. Never put real values in this file or in any committed file.
# Locally: copy to .env (gitignored). In CI: repository secrets and variables.

# Model roles (ARCHITECTURE.md > Models). Provider: vertex (default) | anthropic | openai | openrouter
EXTRACT_PROVIDER=vertex
EXTRACT_MODEL=                   # from a repo variable, never in code
CHECK_PROVIDER=                  # reviewer and UX review
CHECK_MODEL=
EVAL_MODELS=                     # optional, comma separated, compares models of EXTRACT_PROVIDER

# Vertex AI: keyless Google login (gcloud auth application-default login locally)
VERTEX_PROJECT_ID=
VERTEX_REGION=                   # must start with europe-

# Secrets (set by a human with gh secret set, never by an agent)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
