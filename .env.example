# Names only. Never put real values in this file or in any committed file.
# Locally: copy to .env (gitignored). In CI: repository secrets and variables.

# Model routing (MODELS.md)
MODEL_PROVIDER=openrouter        # openrouter (dev, anonymized evals) | vertex (real client data)
APP_MODEL=                       # model id for the chosen provider, from a repo variable
EVAL_MODELS=                     # optional, comma separated, compares models in npm run evals

# Secrets (set by a human with gh secret set, never by an agent)
OPENROUTER_API_KEY=

# Vertex AI (real client data, EU only)
VERTEX_PROJECT_ID=
VERTEX_REGION=                   # must start with europe-
