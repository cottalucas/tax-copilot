{
  "name": "tax-copilot",
  "private": true,
  "version": "0.1.0",
  "description": "Tax Copilot for Expatify: extraction engine, tax rules and review portal for one tax preparer.",
  "type": "module",
  "main": "lib/src/functions/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "check": "npm run check:types && npm run check:lint && npm run check:secrets && npm run check:design",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:lint": "eslint .",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:unit": "vitest run -c vitest.config.ts --coverage && node scripts/coverage-floor.mjs",
    "test:integration": "firebase emulators:exec --only firestore --project demo-tax-copilot \"vitest run -c vitest.integration.config.ts\"",
    "test:e2e": "playwright test",
    "evals": "tsx evals/run.ts",
    "build": "npm run build:web && npm run build:functions",
    "build:web": "vite build",
    "build:functions": "tsc -p tsconfig.build.json",
    "dev": "vite",
    "check:design": "design.md lint DESIGN.md > /dev/null",
    "ux-review": "tsx scripts/ux-review.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "openai": "^7.61.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@google/design.md": "^0.4.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.36.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
